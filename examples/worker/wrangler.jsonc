{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "aether-worker-example",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "dev": { "ip": "127.0.0.1", "port": 8787 },
  "vars": {
    "APPLICATION_ID": "aether-worker-example",
    "APP_ORIGIN": "http://127.0.0.1:8787",
    "TEST_MODE": "true",
    "ALLOW_LOOPBACK_HTTP": "true",
    "ALLOW_LOOPBACK_OUTBOUND": "true",
    "OUTBOUND_ORIGINS": "[\"http://127.0.0.1:9000\"]"
  },
  "d1_databases": [
    {
      "binding": "AETHER_DB",
      "database_name": "aether-worker-example",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../packages/worker/migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "AETHER_FILES", "bucket_name": "aether-worker-example" }
  ],
  "durable_objects": {
    "bindings": [{ "name": "RUNS", "class_name": "RunCoordinator" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RunCoordinator"] }],
  "env": {
    "production": {
      "vars": {
        "APPLICATION_ID": "aether-worker-example",
        "APP_ORIGIN": "https://aether.example.com",
        "TEST_MODE": "false",
        "ALLOW_LOOPBACK_HTTP": "false",
        "ALLOW_LOOPBACK_OUTBOUND": "false",
        "OUTBOUND_ORIGINS": "[\"https://api.openai.com\"]"
      },
      "d1_databases": [{ "binding": "AETHER_DB", "database_name": "aether-worker-example", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "../../packages/worker/migrations" }],
      "r2_buckets": [{ "binding": "AETHER_FILES", "bucket_name": "aether-worker-example" }],
      "durable_objects": { "bindings": [{ "name": "RUNS", "class_name": "RunCoordinator" }] },
      "services": [{ "binding": "OUTBOUND_GATEWAY", "service": "aether-trusted-egress" }]
    }
  }
}
