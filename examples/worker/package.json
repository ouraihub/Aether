{
  "name": "@ouraihub/aether-worker-example",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "init:local": "node scripts/init-local.mjs",
    "dev:https": "wrangler dev --ip 127.0.0.1 --port 8787 --local-protocol https --var APP_ORIGIN:https://127.0.0.1:8787",
    "dev": "wrangler dev --ip 127.0.0.1 --port 8787",
    "build": "wrangler deploy --dry-run --outdir dist",
    "dry-run": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "migrate:local": "wrangler d1 migrations apply AETHER_DB --local",
    "migrate:remote": "wrangler d1 migrations apply AETHER_DB --remote"
  },
  "dependencies": {
    "@ouraihub/aether-contracts": "workspace:*",
    "@ouraihub/aether-core": "workspace:*",
    "@ouraihub/aether-worker": "workspace:*"
  }
}
