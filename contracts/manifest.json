{
  "contractVersion": 1,
  "schemaDraft": "http://json-schema.org/draft-07/schema#",
  "normativeSource": "docs/22-详细设计-跨运行时公共契约.md",
  "schemas": ["common.schema.json", "error.schema.json", "run.schema.json", "conversation.schema.json"],
  "bindingsDirectory": "packages/contracts/src/generated",
  "contracts": {
    "RunRequest": { "schema": "run.schema.json", "definition": "RunRequest", "owner": "runtime::contract" },
    "RunAccepted": { "schema": "run.schema.json", "definition": "RunAccepted", "owner": "runtime::contract" },
    "RunSnapshot": { "schema": "run.schema.json", "definition": "RunSnapshot", "owner": "runtime::contract" },
    "RunStatus": { "schema": "run.schema.json", "definition": "RunStatus", "owner": "runtime::contract" },
    "Ack": { "schema": "run.schema.json", "definition": "Ack", "owner": "runtime::contract" },
    "RunEvent": { "schema": "run.schema.json", "definition": "RunEvent", "owner": "chat" },
    "EndStatus": { "schema": "run.schema.json", "definition": "EndStatus", "owner": "chat" },
    "ToolOutcome": { "schema": "run.schema.json", "definition": "ToolOutcome", "owner": "chat" },
    "KitError": { "schema": "error.schema.json", "definition": "KitError", "owner": "support" },
    "KitErrorCode": { "schema": "error.schema.json", "definition": "KitErrorCode", "owner": "support" },
    "Details": { "schema": "error.schema.json", "definition": "Details", "owner": "support" },
    "Conversation": {
      "schema": "conversation.schema.json",
      "definition": "Conversation",
      "owner": "runtime::contract::conversation_dto"
    },
    "ConversationSummary": {
      "schema": "conversation.schema.json",
      "definition": "ConversationSummary",
      "owner": "runtime::contract::conversation_dto"
    },
    "Turn": {
      "schema": "conversation.schema.json",
      "definition": "Turn",
      "owner": "runtime::contract::conversation_dto"
    },
    "TurnStatus": {
      "schema": "conversation.schema.json",
      "definition": "TurnStatus",
      "owner": "runtime::contract::conversation_dto"
    },
    "ModelRef": { "schema": "common.schema.json", "definition": "ModelRef", "owner": "providers" },
    "ContextRef": { "schema": "common.schema.json", "definition": "ContextRef", "owner": "runtime::contract" },
    "SkillRef": { "schema": "common.schema.json", "definition": "SkillRef", "owner": "support" },
    "ImagePart": { "schema": "common.schema.json", "definition": "ImagePart", "owner": "images" },
    "ImageRef": { "schema": "common.schema.json", "definition": "ImageRef", "owner": "images" },
    "SearchHit": { "schema": "common.schema.json", "definition": "SearchHit", "owner": "search" },
    "TokenUsage": { "schema": "common.schema.json", "definition": "TokenUsage", "owner": "support" },
    "ContextUsage": { "schema": "common.schema.json", "definition": "ContextUsage", "owner": "support" },
    "ContextSource": { "schema": "common.schema.json", "definition": "ContextSource", "owner": "support" },
    "Cost": { "schema": "common.schema.json", "definition": "Cost", "owner": "support" },
    "Currency": { "schema": "common.schema.json", "definition": "Currency", "owner": "support" },
    "ReasoningEffort": { "schema": "common.schema.json", "definition": "ReasoningEffort", "owner": "support" },
    "PermissionMode": { "schema": "common.schema.json", "definition": "PermissionMode", "owner": "support" },
    "ToolEffect": { "schema": "common.schema.json", "definition": "ToolEffect", "owner": "support" },
    "Approval": { "schema": "common.schema.json", "definition": "Approval", "owner": "support" }
  },
  "coverage": {
    "data": "Strict object fields, enum values, required/optional/null, numeric and input limits, all event variants, safe error and conversation projections.",
    "behavior": "scenarios.json is a language-neutral acceptance specification, not a passed backend execution report.",
    "outsideSchema": [
      "Owner and conversation membership",
      "Action combinations and effective source selection",
      "Purpose/capability authorization",
      "Image content decoding and actual MIME",
      "Controlled ImageRef URL provenance",
      "Secret redaction inside allowed strings and authorized arbitrary payload",
      "Event order, persistence, dispatch and cancellation"
    ],
    "unknownFields": "Rejected in every structured object, including responses. Only tool_result.payload permits arbitrary JSON; its authorization and budget are host behavior."
  },
  "rustOutput": {
    "argument": "--rust-output <file|->",
    "defaultCommand": [
      "cargo",
      "build",
      "-p",
      "aether-runtime",
      "--features",
      "runs",
      "--example",
      "contract-output",
      "--quiet"
    ],
    "execution": "After building, directly execute debug/examples/contract-output(.exe) under CARGO_TARGET_DIR (relative to repository root) or root/target; only the executable stdout is parsed as JSON.",
    "format": "JSON array of {contract: manifest contract name, value: actual serde_json output}",
    "requiredContracts": ["RunAccepted", "RunSnapshot", "RunEvent", "KitError", "Conversation"],
    "requiredEventKinds": [
      "search_start",
      "search_result",
      "round_start",
      "text_delta",
      "reasoning_delta",
      "tool_call",
      "approval_required",
      "tool_result",
      "usage",
      "context",
      "end"
    ],
    "requiredSnapshotStatuses": ["running", "completed", "failed", "cancelled"]
  }
}
