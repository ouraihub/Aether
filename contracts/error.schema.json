{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aether.local/contracts/v1/error.schema.json",
  "$ref": "#/definitions/KitError",
  "definitions": {
    "KitErrorCode": {
      "enum": [
        "bad_request",
        "not_found",
        "conflict",
        "unsupported",
        "cancelled",
        "unauthorized",
        "forbidden",
        "rate_limited",
        "upstream",
        "timeout",
        "network",
        "needs_config",
        "budget_exceeded",
        "incompatible_db",
        "internal"
      ]
    },
    "Details": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "field": { "type": "string" },
        "reason": { "type": "string" },
        "status": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "limit": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "entity": { "type": "string" },
        "port": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "errorId": { "type": "string" }
      }
    },
    "KitError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "$ref": "#/definitions/KitErrorCode" },
        "message": { "type": "string" },
        "details": { "$ref": "#/definitions/Details" }
      }
    }
  }
}
