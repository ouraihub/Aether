{
  "name": "@ouraihub/aether-worker",
  "version": "0.1.0",
  "license": "LGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ouraihub/Aether.git",
    "directory": "packages/worker"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./providers": "./src/providers/index.ts",
    "./search": "./src/search/index.ts",
    "./images": "./src/images/index.ts",
    "./skills": "./src/skills/index.ts",
    "./mcp": "./src/mcp/index.ts",
    "./conversations": "./src/conversations/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@ouraihub/aether-contracts": "workspace:*",
    "@ouraihub/aether-core": "workspace:*"
  },
  "devDependencies": {},
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.svelte",
    "!src/**/__tests__",
    "migrations"
  ],
  "publishConfig": {
    "access": "public"
  }
}
